-- 1. Severity scores (legitimately first-24h by definition)
-- ------------------------------------------------------------
-- CAVEAT for the clinician to check before trusting sapsii:
-- MIT's sapsii concept awards points for metastatic cancer, haematologic
-- malignancy and AIDS, which it derives from DISCHARGE ICD codes. That
-- component is not knowable at t0. Read the concept SQL in the mimic-code
-- repo and decide whether to (a) accept it as the paper did, or (b) rebuild
-- SAPS II without the comorbidity points. Report whichever you choose.
-- COLUMN NAMES: first_day_sofa DROPS the _24hours suffix. The mimic-code
-- concept selects  sofa_24hours AS sofa, respiration_24hours AS respiration, ...
-- so the columns here are sofa / respiration / coagulation / liver /
-- cardiovascular / cns / renal.  (The _24hours names live in the hourly
-- `sofa` table, not in first_day_sofa.)
-- Verify before running:
--   SELECT column_name FROM `physionet-data.mimiciv_3_1_derived.INFORMATION_SCHEMA.COLUMNS`
--   WHERE table_name IN ('first_day_sofa','sapsii','apsiii') ORDER BY table_name, ordinal_position;

CREATE OR REPLACE TABLE `BMI5101group_project.severity_scores` AS
SELECT
  c.first_stay_id,
  s.sapsii,
  s.sapsii_prob,
  a.apsiii,
  a.apsiii_prob,
  f.sofa           AS sofa_day1,
  f.respiration    AS sofa_resp,
  f.coagulation    AS sofa_coag,
  f.liver          AS sofa_liver,
  f.cardiovascular AS sofa_cardio,
  f.cns            AS sofa_cns,
  f.renal          AS sofa_renal
FROM `BMI5101group_project.cohort` c
LEFT JOIN `physionet-data.mimiciv_3_1_derived.sapsii`         s ON s.stay_id = c.first_stay_id
LEFT JOIN `physionet-data.mimiciv_3_1_derived.apsiii`         a ON a.stay_id = c.first_stay_id
LEFT JOIN `physionet-data.mimiciv_3_1_derived.first_day_sofa` f ON f.stay_id = c.first_stay_id;

